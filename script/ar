#!/usr/bin/env python3
"""Forward MoonBit's package archive step to the selected Linux ar tool."""

import os
import shlex
import subprocess
import sys


value = os.environ.get("AR", "ar")
tool = [value] if os.path.isfile(value) else shlex.split(value)
if not tool:
    raise SystemExit("AR must name an archiver")
raise SystemExit(subprocess.run([*tool, *sys.argv[1:]], check=False).returncode)
