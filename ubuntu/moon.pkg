import {
  "f4ah6o/gpui/platform",
  "f4ah6o/gpui/platform/linux_text",
  "f4ah6o/gpui/text",
  "f4ah6o/gpui/primitives",
  "f4ah6o/gpui/diagnostics",
  "f4ah6o/gpui/scene",
  "f4ah6o/gpui/platform/testing",
  "f4ah6o/gpui/accessibility",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "native"

import {
  "moonbitlang/core/env",
  "f4ah6o/gpui/testing/backend" @conformance,
} for "wbtest"

options(
  "native-stub": [
    "backend.c",
    "xdg-shell-protocol.c",
    "text-input-v1-protocol.c",
  ],
  link: {
    "native": {
      "cc": "script/linux_text_cc.py",
      "cc-flags": "-O2 -std=c11 -Wall -Wextra",
      "cc-link-flags": "-lwayland-client -lwayland-cursor -lwayland-egl -lEGL -lGLESv2 -lxkbcommon -lpthread -lm",
      "stub-cc": "script/linux_text_cc.py",
      "stub-cc-flags": "-std=c11 -Wall -Wextra",
    },
  },
)
