{
  "version": 1,
  "id": "cursor-backspace-delete",
  "description": "Directional movement, deletion and Shift selection.",
  "platform": "linux-x11-weston",
  "disposition": "pending",
  "reason": "Driver can express these OS keys, but exact text and directional selection need a reviewed observer before activation.",
  "timeout_ms": 15000,
  "initial": {
    "text": "Hello 日本",
    "selection": {
      "anchor": 8,
      "head": 8
    },
    "focused": true
  },
  "focus_click": {
    "type": "click",
    "x": 500,
    "y": 50
  },
  "steps": [
    {
      "id": "replace",
      "events": [
        {
          "type": "key",
          "keysym": "Home",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "End",
          "modifiers": [
            "Shift_L"
          ]
        },
        {
          "type": "key",
          "keysym": "a",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "b",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "c",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "d",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "e",
          "modifiers": []
        }
      ],
      "expect": {
        "text": "abcde",
        "selection": {
          "anchor": 5,
          "head": 5
        },
        "focused": true
      }
    },
    {
      "id": "backspace",
      "events": [
        {
          "type": "key",
          "keysym": "Left",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "Left",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "BackSpace",
          "modifiers": []
        }
      ],
      "expect": {
        "text": "abde",
        "selection": {
          "anchor": 2,
          "head": 2
        },
        "focused": true
      }
    },
    {
      "id": "delete",
      "events": [
        {
          "type": "key",
          "keysym": "Delete",
          "modifiers": []
        }
      ],
      "expect": {
        "text": "abe",
        "selection": {
          "anchor": 2,
          "head": 2
        },
        "focused": true
      }
    },
    {
      "id": "select",
      "events": [
        {
          "type": "key",
          "keysym": "Home",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "Right",
          "modifiers": []
        },
        {
          "type": "key",
          "keysym": "Right",
          "modifiers": [
            "Shift_L"
          ]
        }
      ],
      "expect": {
        "text": "abe",
        "selection": {
          "anchor": 1,
          "head": 2
        },
        "focused": true
      }
    }
  ],
  "oracle": {
    "kind": "pending",
    "reason": "Exact presented-state observer is proposed but not integrated/reviewed; do not treat OCR or a fresh screenshot as a golden."
  },
  "expected_failure": null,
  "artifacts": [
    "case.json",
    "result.json",
    "focused.png",
    "final.png",
    "app.log",
    "weston.log",
    "xvfb.log",
    "events.jsonl"
  ],
  "provenance": {
    "source_commit": "bf8a332595aad7fb69928719cc4b25464269a4d5",
    "source_tree": "5441e254b2c7760e9b7184e87725f7ed2a43085c",
    "app_sha256": null,
    "patch_sha256": null,
    "fontconfig_sha256": null,
    "notes": "Accepted text-field/undo source baseline. This planned case has not run through the packaged driver. Pin the actual reviewed observer/repeat build and source diff before activation."
  }
}
