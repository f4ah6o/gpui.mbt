+
+  assert(api->call(23, 0, 0, 0, NULL, 0) == 0);
+  assert(api->integer(1) == 4);
+  assert(api->integer(3) == [scale_event[@"seq"] longLongValue]);
+  NSString *scale_only_geometry = session_payload(@"ab", 1, 1, 21, 0, 74, 54, YES);
