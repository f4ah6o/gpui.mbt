predicate valid_text_range(range : TextRange) {
  0 <= range.start && range.start <= range.end && range.end <= 2147483647
}

predicate unicode_bounds(scalar : Int) {
  0 <= scalar && scalar <= 0x10FFFF
}

predicate unicode_non_surrogate(scalar : Int) {
  scalar < 0xD800 || 0xDFFF < scalar
}

predicate valid_unicode_scalar(scalar : Int) {
  unicode_bounds(scalar) && unicode_non_surrogate(scalar)
}

predicate utf8_width_post(scalar : Int, width : Int) {
  1 <= width && width <= 4 &&
  ((scalar <= 0x7F && width == 1) ||
   (0x7F < scalar && scalar <= 0x7FF && width == 2) ||
   (0x7FF < scalar && scalar <= 0xFFFF && width == 3) ||
   (0xFFFF < scalar && width == 4))
}

predicate utf16_width_post(scalar : Int, width : Int) {
  1 <= width && width <= 2 &&
  ((scalar <= 0xFFFF && width == 1) || (0xFFFF < scalar && width == 2))
}

lemma preconditions_are_inhabited() where {
  proof_ensure: valid_unicode_scalar(0),
  proof_ensure: valid_unicode_scalar(0x10FFFF),
} {}

