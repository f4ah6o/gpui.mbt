import {
  "f4ah6o/hotpath/src" @hotpath,
  "f4ah6o/gpui/controls/text_field" @field,
  "f4ah6o/gpui/controls/command_palette" @palette,
  "f4ah6o/gpui/element",
  "f4ah6o/gpui/capability",
  "f4ah6o/gpui/platform/linux_text",
  "f4ah6o/gpui/text",
  "f4ah6o/gpui/text_layout",
  "f4ah6o/gpui/primitives",
  "f4ah6o/gpui/scene",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "clock.c" ],
  link: {
    "native": {
      "cc": "script/linux_text_cc.py",
      "cc-flags": "-O2 -std=c11 -Wall -Wextra",
      "cc-link-flags": "-lpthread -lm",
    },
  },
)
