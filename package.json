{
  "name": "gpui-mbt-browser-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "browser:install": "playwright install --with-deps chromium",
    "browser:smoke": "node tests/browser/smoke.mjs",
    "browser:board:smoke": "node tests/browser/board.mjs",
    "browser:dev-watch": "node tests/browser/dev-watch.mjs",
    "browser:services:test": "node --test tests/browser/clipboard.test.mjs tests/browser/text-input.test.mjs",
    "browser:canvas:test": "node --test tests/browser/canvas-renderer.test.mjs tests/browser/canvas-accessibility.test.mjs",
    "migration:host:test": "node --test tests/browser/migration-host.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plugin-moonbit": "0.5.1",
    "vite-plus": "1.0.0"
  },
  "packageManager": "pnpm@12.9.1",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vitest@*": "5.0.1"
    }
  }
}
