import {
  "f4ah6o/gpui/platform/macos",
  "f4ah6o/gpui/platform/macos_text",
  "f4ah6o/gpui/platform",
  "f4ah6o/gpui/primitives",
  "f4ah6o/gpui/text",
  "f4ah6o/gpui/text_layout",
  "f4ah6o/gpui/controls/text_field",
  "f4ah6o/gpui/scene",
  "f4ah6o/gpui/element",
  "f4ah6o/gpui/diagnostics",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "state_observer.c" ],
  link: {
    "native": {
      "cc": "script/macos_text_cc.py",
      "cc-flags": "-O2 -std=c11",
      "stub-cc": "script/macos_text_cc.py",
      "stub-cc-flags": "-O2 -std=c11 -Wall -Wextra -Werror",
    },
  },
)
