import {
  "f4ah6o/gpui/accessibility" @accessibility,
  "f4ah6o/gpui/ubuntu" @native,
  "f4ah6o/gpui/platform",
  "f4ah6o/gpui/diagnostics",
  "f4ah6o/gpui/primitives",
  "f4ah6o/gpui/examples/ubuntu_button/fixture",
  "moonbitlang/core/env",
}

import {
  "f4ah6o/gpui/accessibility" @accessibility,
  "f4ah6o/gpui/ubuntu" @native,
  "f4ah6o/gpui/examples/ubuntu_button/fixture" @fixture,
  "moonbitlang/core/env",
} for "wbtest"

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc": "script/linux_text_cc.py",
      "cc-flags": "-O2 -std=c11 -Wall -Wextra",
      "cc-link-flags": "-lwayland-client -lwayland-cursor -lwayland-egl -lEGL -lGLESv2 -lxkbcommon -lpthread -lm",
    },
  },
)
