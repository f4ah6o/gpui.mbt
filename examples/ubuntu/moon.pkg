import {
  "f4ah6o/gpui/ubuntu" @native,
  "f4ah6o/gpui/platform",
  "f4ah6o/gpui/diagnostics",
  "f4ah6o/gpui/primitives",
  "f4ah6o/gpui/scene",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc": "cc",
      "cc-link-flags": "-lwayland-client -lwayland-egl -lEGL -lGLESv2 -lxkbcommon -lpthread -lm",
    },
  },
)
